<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Simple Pong</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div class="game-container">
    <header>
      <h1>Simple Pong</h1>
      <div class="scoreboard">
        <div class="score"><span id="playerScore">0</span> — Player</div>
        <div class="score"><span id="aiScore">0</span> — Computer</div>
      </div>
    </header>

    <canvas id="game" width="800" height="500"></canvas>

    <footer class="controls">
      Controls: Move left paddle with mouse or Arrow Up / Arrow Down. Press Space to pause/resume. Press Enter to reset scores.
    </footer>
  </div>

  <script src="script.js"></script>
</body>
</html>
