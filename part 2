:root{
  --bg:#0b1724;
  --panel:#09111a;
  --accent:#2dd4bf;
  --muted:#9aa6b2;
}

*{box-sizing:border-box}
html,body{
  height:100%;
  margin:0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  background: linear-gradient(180deg,#071018 0%, #071722 100%);
  color:#e6eef3;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

.game-container{
  min-height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  padding:24px;
}

header{
  width:800px;
  max-width:95vw;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

h1{margin:0;font-size:18px;font-weight:600}
.scoreboard{display:flex;gap:12px;align-items:center}
.score{font-size:14px;color:var(--muted)}

canvas{
  background: radial-gradient(circle at 50% 40%, rgba(255,255,255,0.02), transparent 20%), linear-gradient(180deg, rgba(255,255,255,0.01), transparent);
  border: 2px solid rgba(255,255,255,0.04);
  box-shadow: 0 8px 30px rgba(2,6,23,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
  border-radius: 6px;
  width:800px;
  max-width:95vw;
  height:500px;
  cursor:crosshair;
  display:block;
}

.controls{width:800px;max-width:95vw;text-align:center;color:var(--muted);font-size:13px}
